const express = require("express"); 
const app = express();
const PORT = 3000;

app.use(express.json());

let seats = {};
const TOTAL_SEATS = 10;
const LOCK_DURATION = 60 * 1000;

for (let i = 1; i <= TOTAL_SEATS; i++) {
  seats[i] = { status: "available", lockedBy: null, lockExpiresAt: null };
}

function cleanupExpiredLocks() {
  const now = Date.now();
  for (let id in seats) {
    if (seats[id].status === "locked" && seats[id].lockExpiresAt <= now) {
      seats[id] = { status: "available", lockedBy: null, lockExpiresAt: null };
    }
  }
}

app.get("/seats", (req, res) => {
  cleanupExpiredLocks();
  res.json(seats);
});

app.post("/seats/lock", (req, res) => {
  const { seatId, userId } = req.body;
  cleanupExpiredLocks();

  if (!seatId || !userId) {
    return res.status(400).json({ error: "seatId and userId are required" });
  }

  const seat = seats[seatId];
  if (!seat) return res.status(404).json({ error: "Seat not found" });

  if (seat.status === "available") {
    seat.status = "locked";
    seat.lockedBy = userId;
    seat.lockExpiresAt = Date.now() + LOCK_DURATION;
    return res.json({ message: `Seat ${seatId} locked for user ${userId}` });
  }

  if (seat.status === "locked") {
    return res.status(409).json({ error: `Seat ${seatId} is already locked` });
  }

  if (seat.status === "booked") {
    return res.status(409).json({ error: `Seat ${seatId} is already booked` });
  }
});

app.post("/seats/confirm", (req, res) => {
  const { seatId, userId } = req.body;
  cleanupExpiredLocks();

  if (!seatId || !userId) {
    return res.status(400).json({ error: "seatId and userId are required" });
  }

  const seat = seats[seatId];
  if (!seat) return res.status(404).json({ error: "Seat not found" });

  if (seat.status === "locked" && seat.lockedBy === userId) {
    seat.status = "booked";
    seat.lockedBy = null;
    seat.lockExpiresAt = null;
    return res.json({ message: `Seat ${seatId} successfully booked by ${userId}` });
  }

  if (seat.status === "locked" && seat.lockedBy !== userId) {
    return res.status(403).json({ error: "You did not lock this seat" });
  }

  if (seat.status === "booked") {
    return res.status(409).json({ error: `Seat ${seatId} is already booked` });
  }

  res.status(400).json({ error: "Seat must be locked before confirming" });
});

app.listen(PORT, () => {
  console.log(`🚀 Server running at http://localhost:${PORT}`);
});
